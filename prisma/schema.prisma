generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ──────────────────────────────────────────────────
// Lookup Tables
// ──────────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // seeded roles (e.g. ADMIN) cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Resource {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?
  sensitivity String   @default("MEDIUM") @db.VarChar(20) // LOW | MEDIUM | HIGH | CRITICAL
  createdAt   DateTime @default(now()) @map("created_at")

  permissions Permission[]

  @@map("resources")
}

model Permission {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(150)
  action     String   @db.VarChar(20) // READ | WRITE | APPROVE | MANAGE | ADMIN
  resourceId Int      @map("resource_id")
  createdAt  DateTime @default(now()) @map("created_at")

  resource Resource @relation(fields: [resourceId], references: [id])

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  accessRequests  AccessRequest[]

  @@index([resourceId])
  @@map("permissions")
}

// ──────────────────────────────────────────────────
// Users
// ──────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash")
  fullName     String    @db.VarChar(150)
  roleId       Int       @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")
  lastLoginIp       String?   @map("last_login_ip") @db.VarChar(45)
  lastLoginLocation String?   @map("last_login_location") @db.VarChar(200)
  lastLoginLat      Float?    @map("last_login_lat") @db.DoublePrecision
  lastLoginLng      Float?    @map("last_login_lng") @db.DoublePrecision
  lastLoginAddress  String?   @map("last_login_address")
  lastLoginPincode  String?   @map("last_login_pincode") @db.VarChar(20)
  lastLoginCity     String?   @map("last_login_city") @db.VarChar(100)
  lastLoginState    String?   @map("last_login_state") @db.VarChar(100)
  lastLoginCountry  String?   @map("last_login_country") @db.VarChar(100)
  lastLoginSource   String?   @map("last_login_source") @db.VarChar(10) // "gps" | "ip"

  // ── Password Login Lockout (account-takeover mitigation) ──
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  // ── Two-Factor Authentication ──
  totpEnabled      Boolean   @default(false) @map("totp_enabled")
  totpSecret       String?   @map("totp_secret")       // AES-256-GCM encrypted
  totpBackupCodes  String?   @map("totp_backup_codes")  // JSON array of bcrypt hashes
  totpFailedCount  Int       @default(0) @map("totp_failed_count")
  totpLockedUntil  DateTime? @map("totp_locked_until")

  // ── Passkey (WebAuthn) Authentication ──
  passkeyEnabled        Boolean   @default(false) @map("passkey_enabled")
  webauthnChallenge     String?   @map("webauthn_challenge")        // active challenge (base64url)
  webauthnChallengeExp  DateTime? @map("webauthn_challenge_exp")    // expiry for the challenge

  role Role @relation(fields: [roleId], references: [id])

  auditLogs         AuditLog[]
  passkeys          Passkey[]
  directPermissions UserPermission[]       @relation("UserPermissionGrantee")
  grantedPermissions UserPermission[]      @relation("UserPermissionGrantor")
  rolePermissionsGranted RolePermission[]  @relation("RolePermissionGrantor")
  accessRequests    AccessRequest[]        @relation("AccessRequester")
  reviewedRequests  AccessRequest[]        @relation("AccessReviewer")
  passwordResetTokens PasswordResetToken[]

  @@index([roleId])
  @@map("users")
}

// ──────────────────────────────────────────────────
// Passkeys (WebAuthn)
// ──────────────────────────────────────────────────

model Passkey {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  credentialId String   @unique @map("credential_id")   // base64url-encoded credential ID
  publicKey    Bytes    @map("public_key")               // COSE public key
  counter      BigInt   @default(0)
  deviceType   String   @map("device_type") @db.VarChar(20) // "singleDevice" | "multiDevice"
  backedUp     Boolean  @default(false)
  transports   String?                                    // JSON array: ["internal","usb","ble","nfc"]
  friendlyName String?  @map("friendly_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passkeys")
}

// ──────────────────────────────────────────────────
// Role → Permission → Resource mapping
// ──────────────────────────────────────────────────

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  grantedById  Int      @map("granted_by_id")
  grantedAt    DateTime @default(now()) @map("granted_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("RolePermissionGrantor", fields: [grantedById], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Direct grants to a specific user, outside their role baseline —
// created when an AccessRequest is approved.
model UserPermission {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  permissionId       Int       @map("permission_id")
  grantedById        Int       @map("granted_by_id")
  grantedAt          DateTime  @default(now()) @map("granted_at")
  expiresAt          DateTime? @map("expires_at")
  sourceAccessRequestId Int?   @unique @map("source_access_request_id")

  user       User       @relation("UserPermissionGrantee", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("UserPermissionGrantor", fields: [grantedById], references: [id])
  sourceAccessRequest AccessRequest? @relation(fields: [sourceAccessRequestId], references: [id])

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ──────────────────────────────────────────────────
// Access Requests
// ──────────────────────────────────────────────────

model AccessRequest {
  id            Int       @id @default(autoincrement())
  requesterId   Int       @map("requester_id")
  permissionId  Int       @map("permission_id")
  justification String
  status        String    @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED | REVOKED
  reviewedById  Int?      @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  requester   User        @relation("AccessRequester", fields: [requesterId], references: [id])
  permission  Permission  @relation(fields: [permissionId], references: [id])
  reviewedBy  User?       @relation("AccessReviewer", fields: [reviewedById], references: [id])
  grantedPermission UserPermission?

  @@index([requesterId])
  @@index([status])
  @@map("access_requests")
}

// ──────────────────────────────────────────────────
// Password Reset
// ──────────────────────────────────────────────────

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64) // sha256 hex of the raw token
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  requestIp  String?   @map("request_ip") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ──────────────────────────────────────────────────
// Audit Log
// ──────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(50)
  detail    String?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
